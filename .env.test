# Configuración de Pruebas de Integración (Aislada de Desarrollo)
API_PORT=8001

# Base de Datos de Prueba (Postgres en puerto 5434 del host)
POSTGRES_USER=test_pubtube
POSTGRES_PASSWORD=test_pubtube_secret
POSTGRES_DB=test_pubtube_db
POSTGRES_PORT=5434

# URL de Conexión a Base de Datos de Prueba (Host)
DATABASE_URL=postgresql://test_pubtube:test_pubtube_secret@localhost:5434/test_pubtube_db

# Garage de Prueba (Puerto 9100 del host mapeado al 3900 interno)
MINIO_ENDPOINT=localhost
MINIO_PORT=9100
MINIO_API_PORT=9100
MINIO_ACCESS_KEY=testminioadmin
MINIO_SECRET_KEY=testminioadmin
MINIO_BUCKET_CONTENT=videos
MINIO_BUCKET_THUMBNAILS=thumbnails
