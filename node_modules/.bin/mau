#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/eizy/git/hub/pubtube/temp-nest/node_modules/.pnpm/@nestjs+mau@0.2.6/node_modules/@nestjs/mau/node_modules:/home/eizy/git/hub/pubtube/temp-nest/node_modules/.pnpm/@nestjs+mau@0.2.6/node_modules:/home/eizy/git/hub/pubtube/temp-nest/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/home/eizy/git/hub/pubtube/temp-nest/node_modules/.pnpm/@nestjs+mau@0.2.6/node_modules/@nestjs/mau/node_modules:/home/eizy/git/hub/pubtube/temp-nest/node_modules/.pnpm/@nestjs+mau@0.2.6/node_modules:/home/eizy/git/hub/pubtube/temp-nest/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../@nestjs/mau/bin/mau.js" "$@"
else
  exec node  "$basedir/../@nestjs/mau/bin/mau.js" "$@"
fi
